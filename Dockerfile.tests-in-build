# Builds the app and runs the tests, which use Testcontainers, during the build. The RUN step
# starts kubedock with the kubeconfig that okteto-tests-in-build.yml passes as a build secret.
FROM joyrex2001/kubedock:0.23.0 AS kubedock

FROM maven:3.9-eclipse-temurin-21 AS build

COPY --from=kubedock /usr/local/bin/kubedock /usr/local/bin/kubedock

ARG OKTETO_NAMESPACE

WORKDIR /src
COPY start-kubedock.sh pom.xml ./
COPY src ./src

RUN --mount=type=secret,id=kubeconfig,target=/root/.kube/config \
    ./start-kubedock.sh && \
    DOCKER_HOST=tcp://127.0.0.1:2475 TESTCONTAINERS_RYUK_DISABLED=true mvn -B package

FROM eclipse-temurin:21-jre

WORKDIR /app
COPY --from=build /src/target/testcontainers-example-1.0.0.jar app.jar
COPY --from=build /src/target/lib ./lib

CMD ["java", "-cp", "app.jar:lib/*", "example.HelloWorld"]
